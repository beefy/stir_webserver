# MongoDB connection string
MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# Target database name
MONGODB_DATABASE_NAME=stir_webserver

# Auth microservice base URL
AUTH_SERVICE_URL=http://localhost:3001

# Set to "false" to disable IP-based geolocation blocking
# (blocks requests from restricted US states and countries)
IP_BLOCKING_ENABLED=true

# Set to "false" to allow VPN and proxy connections
# (uses ip-api.com's proxy detection; enabled by default)
BLOCK_VPN=true

# API key for pro.ip-api.com (required for paid plan)
IP_API_KEY=

# DeepSeek API key for content moderation
# (leave empty to record null-action moderations without calling DeepSeek)
DEEPSEEK_API_KEY=
